{
  "name": "hotelorderbooking",
  "version": "1.0.0",
  "description": "Hotel order booking: orders, KOT, GST bills, room folios. Runs as a web app and a desktop app.",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "test": "node db.js",
    "dist": "electron-builder --mac --win"
  },
  "build": {
    "appId": "com.hotelorderbooking.app",
    "productName": "Hotel Orders",
    "files": [
      "*.js",
      "public/**"
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    }
  },
  "dependencies": {
    "express": "^4.22.3",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
